// Default signing values for shared/repo builds.
// Auto-selected local team overrides live in .local-signing.xcconfig (git-ignored).
// Manual local overrides can go in LocalSigning.xcconfig (git-ignored).

#include "Config/Version.xcconfig"

EVE_CODE_SIGN_STYLE = Manual
EVE_CODE_SIGN_IDENTITY = Apple Development
EVE_DEVELOPMENT_TEAM = FWJYW4S8P8

EVE_APP_BUNDLE_ID = ai.evefoundation.app
EVE_SHARE_BUNDLE_ID = ai.evefoundation.app.share
EVE_APP_GROUP_ID = group.ai.evefoundation.app.shared
EVE_WATCH_APP_BUNDLE_ID = ai.evefoundation.app.watchkitapp
EVE_ACTIVITY_WIDGET_BUNDLE_ID = ai.evefoundation.app.activitywidget
EVE_APNS_ENTITLEMENT_ENVIRONMENT = development

EVE_APP_PROFILE = ai.evefoundation.app Development
EVE_SHARE_PROFILE = ai.evefoundation.app.share Development
EVE_ACTIVITY_WIDGET_PROFILE =
EVE_WATCH_APP_PROFILE =

// Keep local includes after defaults: xcconfig is evaluated top-to-bottom,
// so later assignments in local files override the defaults above.
#include? ".local-signing.xcconfig"
#include? "LocalSigning.xcconfig"
