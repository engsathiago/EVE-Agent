{
  "name": "@eve/google-meet",
  "version": "2026.6.8",
  "description": "EVE Google Meet participant plugin for joining calls through Chrome or Twilio transports.",
  "repository": {
    "type": "git",
    "url": "https://github.com/engsathiago/eve-agent"
  },
  "type": "module",
  "dependencies": {
    "commander": "14.0.3",
    "typebox": "1.1.39"
  },
  "devDependencies": {
    "@eve/plugin-sdk": "workspace:*",
    "eve-agent": "workspace:*"
  },
  "peerDependencies": {
    "eve-agent": ">=2026.6.8"
  },
  "peerDependenciesMeta": {
    "eve-agent": {
      "optional": true
    }
  },
  "eve": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "npmSpec": "@eve/google-meet",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.4.20"
    },
    "compat": {
      "pluginApi": ">=2026.6.8"
    },
    "build": {
      "eveVersion": "2026.6.8"
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
