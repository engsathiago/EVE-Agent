{
  "name": "@eve/voice-call",
  "version": "2026.6.8",
  "description": "EVE voice-call plugin for Twilio, Telnyx, and Plivo phone calls.",
  "repository": {
    "type": "git",
    "url": "https://github.com/engsathiago/eve-agent"
  },
  "type": "module",
  "dependencies": {
    "commander": "14.0.3",
    "typebox": "1.1.39",
    "ws": "8.21.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eve/plugin-sdk": "workspace:*",
    "eve-agent": "workspace:*"
  },
  "peerDependencies": {
    "eve-agent": ">=2026.6.8"
  },
  "peerDependenciesMeta": {
    "eve-agent": {
      "optional": true
    }
  },
  "eve": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "npmSpec": "@eve/voice-call",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.4.10"
    },
    "compat": {
      "pluginApi": ">=2026.6.8"
    },
    "build": {
      "eveVersion": "2026.6.8"
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
