{
  "name": "@eve/gmi-provider",
  "version": "2026.6.8",
  "description": "EVE GMI Cloud provider plugin.",
  "repository": {
    "type": "git",
    "url": "https://github.com/engsathiago/eve-agent"
  },
  "type": "module",
  "devDependencies": {
    "@eve/plugin-sdk": "workspace:*"
  },
  "eve": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "clawhubSpec": "clawhub:@eve/gmi-provider",
      "npmSpec": "@eve/gmi-provider",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.6.8"
    },
    "compat": {
      "pluginApi": ">=2026.6.8"
    },
    "build": {
      "eveVersion": "2026.6.8",
      "bundledDist": false
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
